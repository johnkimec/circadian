{
  "version": 1,
  "hooks": {
    "beforeReadFile": [
      { "command": ".cursor/hooks/trace.py", "timeout": 10 }
    ],
    "postToolUse": [
      { "command": ".cursor/hooks/trace.py", "timeout": 10 }
    ],
    "postToolUseFailure": [
      { "command": ".cursor/hooks/trace.py", "timeout": 10 }
    ],
    "preCompact": [
      { "command": ".cursor/hooks/trace.py", "timeout": 10 }
    ],
    "afterAgentResponse": [
      { "command": ".cursor/hooks/trace.py", "timeout": 10 }
    ]
  }
}
